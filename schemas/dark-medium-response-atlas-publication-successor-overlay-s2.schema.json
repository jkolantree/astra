    },
    "pathSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/safePath"}
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/safePath"},
        "mode": {"enum": ["100644", "100755"]},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "packageAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "digest_algorithm", "canonical_byte_domain", "serialization", "canonical_bytes", "sha256"],
      "properties": {
        "scheme": {"const": "astra-package-roster-v1"},
        "scope": {"const": "astra-dark-medium-response-atlas-v0.1.0-publication-package-v1"},
        "digest_algorithm": {"const": "sha256"},
        "canonical_byte_domain": {"const": "git-index-blob"},
        "serialization": {"const": "astra-binary-length-prefixed-v1"},
        "canonical_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "sourceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "digest_algorithm", "canonical_byte_domain", "serialization", "path_encoding", "entry_count", "canonical_bytes", "excluded_paths", "entries", "sha256"],
      "properties": {
        "scheme": {"const": "astra-source-projection-v1"},
        "scope": {"const": "astra-dark-medium-response-atlas-publication-successor-s2-repository-source-v1"},
        "digest_algorithm": {"const": "sha256"},
        "canonical_byte_domain": {"const": "git-index-blob"},
        "serialization": {"const": "astra-binary-length-prefixed-v1"},
        "path_encoding": {"const": "ascii-posix"},
        "entry_count": {"type": "integer", "minimum": 1},
        "canonical_bytes": {"type": "integer", "minimum": 1},
        "excluded_paths": {
          "const": [
            "MANIFEST.sha256",
            "evidence/dark_medium_response_atlas_publication_successor_overlay_s2.json"
          ]
        },
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/fileEntry"}},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    }
