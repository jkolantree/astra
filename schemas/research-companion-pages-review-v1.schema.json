{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jkolantree.github.io/astra/schemas/research-companion-pages-review-v1.schema.json",
  "title": "ASTRA research companion Pages visual review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_sha256",
    "surface",
    "checks",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "https://jkolantree.github.io/astra/schemas/research-companion-pages-review-v1.schema.json"
    },
    "status": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "surface": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_browser_surface",
        "desktop_and_mobile_layout",
        "keyboard_and_focus",
        "reduced_motion",
        "media_playback",
        "console_and_network",
        "assistive_technology",
        "final_publication_approval"
      ],
      "properties": {
        "permitted_browser_surface": {
          "type": "boolean"
        },
        "desktop_and_mobile_layout": {
          "type": "boolean"
        },
        "keyboard_and_focus": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "media_playback": {
          "type": "boolean"
        },
        "console_and_network": {
          "type": "boolean"
        },
        "assistive_technology": {
          "type": "boolean"
        },
        "final_publication_approval": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^evidence/research-companion-browser-review/[A-Za-z0-9_-]+\\.(png|md)$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
