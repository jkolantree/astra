{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jkolantree.github.io/astra/schemas/supplemental-release-identity-v2.schema.json",
  "title": "ASTRA namespaced supplemental detached release identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "repository",
    "repository_id",
    "publication_line_id",
    "version",
    "tag",
    "annotated_tag_object",
    "commit",
    "tree",
    "tracked_manifest",
    "release_spec",
    "successor_overlay",
    "release_date",
    "build_epoch",
    "assets",
    "checksum_covered_assets",
    "sha256sums_sha256",
    "pages_source_files",
    "github_release",
    "pages",
    "identity_excludes_self"
  ],
  "properties": {
    "schema": {
      "const": "https://jkolantree.github.io/astra/schemas/supplemental-release-identity-v2.schema.json"
    },
    "contract_version": {"const": "2.0.0"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
    "repository_id": {"type": "integer", "minimum": 1},
    "publication_line_id": {"$ref": "#/definitions/slug"},
    "version": {"$ref": "#/definitions/semver"},
    "tag": {"$ref": "#/definitions/portableBasename"},
    "annotated_tag_object": {"$ref": "#/definitions/gitObject"},
    "commit": {"$ref": "#/definitions/gitObject"},
    "tree": {"$ref": "#/definitions/gitObject"},
    "tracked_manifest": {"$ref": "#/definitions/pathFileRecord"},
    "release_spec": {"$ref": "#/definitions/pathFileRecord"},
    "successor_overlay": {"$ref": "#/definitions/pathFileRecord"},
    "release_date": {"type": "string", "format": "date"},
    "build_epoch": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/fileRecord"}
    },
    "checksum_covered_assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/definitions/fileRecord"}
    },
    "sha256sums_sha256": {"$ref": "#/definitions/sha256"},
    "pages_source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/pathFileRecord"}
    },
    "github_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "prerelease", "make_latest", "immutable_required"],
      "properties": {
        "draft": {"const": false},
        "prerelease": {"const": true},
        "make_latest": {"const": false},
        "immutable_required": {"const": true}
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versioned_route", "latest_route", "citation_route"],
      "properties": {
        "versioned_route": {"$ref": "#/definitions/pagesRoute"},
        "latest_route": {"$ref": "#/definitions/pagesRoute"},
        "citation_route": {"$ref": "#/definitions/pagesRoute"}
      }
    },
    "identity_excludes_self": {"const": true}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "portableBasename": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)(?!.*[\\x00-\\x1F\\x7F/:\\\\])[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!.*[\\x00-\\x1F\\x7F])(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]*[A-Za-z0-9._-]$"
    },
    "pagesRoute": {"type": "string", "pattern": "^/resources/[a-z0-9][a-z0-9./-]*/$"},
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"$ref": "#/definitions/portableBasename"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "pathFileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/safePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  }
}
